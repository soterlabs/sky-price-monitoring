{
  "name": "sky-price-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SKY/USDS Uniswap V2 price, trading flows and protocol buyback monitoring",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "collect": "node dist/collector.js",
    "rollup": "node dist/daily.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "railway": "^3.11.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
